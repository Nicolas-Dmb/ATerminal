FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen

COPY . .

RUN adduser --disabled-password --gecos "" --no-create-home --uid 10001 "api" && \
    chown -R api:api /app

USER api:api

# uv écrit son cache dans $HOME/.cache par défaut, mais le user "api" n'a pas de
# home (--no-create-home) → on le redirige vers /app, qui lui appartient.
ENV UV_CACHE_DIR=/app/.cache/uv

EXPOSE 8000
CMD ["uv", "run", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
